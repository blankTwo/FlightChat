{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-and-chatgpt",
  "description": "Allows the local Flight Chat interface to control its windows and use application commands.",
  "windows": ["main", "flight-quick"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "allow-enter-flight-mode",
    "allow-prepare-web-bridge",
    "allow-exit-flight-mode",
    "allow-new-conversation",
    "allow-load-conversation-list",
    "allow-select-conversation",
    "allow-send-message",
    "allow-update-command-draft",
    "allow-select-command-option",
    "allow-update-command-suffix",
    "allow-clear-command-selection",
    "allow-set-split-view",
    "allow-restart-app",
    "allow-relay-stream-event"
  ]
}
